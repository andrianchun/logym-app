<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Membantu aplikasi LyFit menemukan aplikasi Health Connect di HP -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Jalur khusus agar Pop-up Izin Health Connect bisa muncul -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <service 
            android:name=".WorkoutTimerService" 
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Workout Timer" />
        </service>
    </application>

    <!-- Permissions Bawaan -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Surat Izin Akses Data Kesehatan Health Connect -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 4 izin ini dulu KETINGGALAN padahal healthConnect.js sudah minta tipe-tipe ini di
         READ_TYPES — akibatnya calories/height/oxygenSaturation/bloodPressure selalu balik
         kosong walau kodenya kelihatan benar (Health Connect gak bisa kasih izin utk tipe
         yang gak dideklarasikan manifest-nya, sama seperti READ_HEALTH_DATA_HISTORY di bawah). -->
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- Banyak sumber (mis. Samsung Health) cuma nulis TotalCaloriesBurned, gak pernah
         ActiveCaloriesBurned — tanpa izin ini query kalori balik kosong terus. -->
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <!-- Buat nulis hasil ukur alat BLE (tensimeter Yuwell, timbangan Xiaomi) lewat
         utils/ble.js. Health Connect gak bisa kasih izin tulis untuk tipe yang gak
         dideklarasikan di sini, walau WRITE_TYPES di healthConnect.js sudah nyebut. -->
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" />
    <!-- Buat nulis kalori terbakar per sesi latihan (lihat hcWriteWorkoutCalories) -->
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <!-- Buat nulis SESI LATIHAN lengkap dengan jenis olahraga, lewat plugin lokal
         ExerciseWriterPlugin.kt. Satu-satunya izin health yang tidak dibawa plugin capgo,
         karena plugin itu memang tidak punya jalur menulis sesi latihan. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- Tanpa ini, Health Connect cuma kasih akses baca 30 hari terakhir — backfill histori
         yang lebih lama gak akan dapat apa-apa. Plugin @capgo/capacitor-health minta ini lewat
         requestHistoryAccess:true (lihat utils/healthConnect.js), tapi izinnya sendiri WAJIB
         dideklarasikan di sini oleh app yang makai, gak ikut ter-auto-merge dari plugin. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
</manifest>
