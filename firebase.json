{
  "functions": [
    {
      "source": "functions",
      "codebase": "logym",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": ["node ../copy-env.cjs"]
    }
  ],
  "hosting": {
    "target": "logym",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
